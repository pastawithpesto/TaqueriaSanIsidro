APP_NAME="Taquería San Isidro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_TIMEZONE=America/Matamoros

# Ruta del sistema interno del taquero (dominio.com/admon). La raíz es para los clientes.
ADMIN_PATH=admon

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=taqueria
DB_USERNAME=taqueria
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
# Credenciales locales. En producción usa valores propios en Portainer.
# Solo para desarrollo local. En producción usa valores largos y aleatorios (ver README).
REVERB_APP_ID=taqueria-local
REVERB_APP_KEY=taqueria-local-key
REVERB_APP_SECRET=taqueria-local-secret
# Publicación desde Laravel: Docker usa reverb; PHP fuera de Docker usa localhost.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Dirección de escucha del servidor; el navegador usa el dominio y puerto de la página.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Puertos expuestos en el host (docker compose)
APP_PORT=8090
VITE_PORT=5174
FORWARD_DB_PORT=5433

# Proxy/túnel delante de la app (ej. * para aceptar X-Forwarded-*). Vacío en local.
TRUSTED_PROXIES=
